# Canonical public site
SITE_ENV=staging
NEXT_PUBLIC_SITE_URL=https://www.milanospizzas.com

# Public ordering provider (the SkyTab storefront URL is not a credential)
ORDER_PROVIDER=skytab
ORDER_MODE=redirect
SKYTAB_ORDER_URL=https://online.skytab.com/29f9af1c8689260fadade27c64cb9e55
SKYTAB_IFRAME_ENABLED=false

# Dormant custom ordering and payment integration
CUSTOM_ORDERING_ENABLED=false
CUSTOM_PAYMENT_ENABLED=false

# Analytics remains disabled until explicitly approved and configured
ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Unverified public features remain disabled
SPECIALS_ENABLED=false
LOYALTY_ENABLED=false
MARKETING_SIGNUP_ENABLED=false
MARKETING_SIGNUP_DESTINATION=
MARKETING_CONSENT_TEXT=
MARKETING_UNSUBSCRIBE_CONFIGURED=false
PRIVACY_COPY_APPROVED=false
X_ENABLED=false
GOOGLE_REVIEW_URL=
