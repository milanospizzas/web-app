# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/milanos_pizza

# Redis
REDIS_URL=redis://localhost:6379

# Session Configuration
SESSION_SECRET=your-secret-key-change-in-production
SESSION_EXPIRY_HOURS=720
MAGIC_LINK_EXPIRY_MINUTES=15

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Dormant custom ordering and payment runtime (fail closed)
CUSTOM_ORDERING_ENABLED=false
CUSTOM_PAYMENT_ENABLED=false
ACCOUNTS_ENABLED=false

# Shift4 Payment Configuration
# Leave blank until a current integration plan, UAT credentials, certification,
# and production approval are supplied by Shift4.
SHIFT4_API_KEY=
SHIFT4_API_SECRET=
SHIFT4_ENVIRONMENT=sandbox
SHIFT4_CLERK_ID=1

# SkyTab POS Configuration (dormant while CUSTOM_ORDERING_ENABLED=false)
SKYTAB_API_KEY=
SKYTAB_API_SECRET=
SKYTAB_LOCATION_ID=
SKYTAB_WEBHOOK_SECRET=
SKYTAB_SYNC_INTERVAL_MINUTES=5

# AWS SES Configuration (leave blank while ACCOUNTS_ENABLED=false)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_FROM_NAME=Milano's Pizzas

# Tax Configuration
TAX_RATE=0.0825

# Loyalty Configuration
LOYALTY_POINTS_PER_DOLLAR=10
LOYALTY_DOLLARS_PER_POINT=0.01

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
